n=int(input("Enter value of n:"))
i=1
while i<=n:
    space=1
    while space <=n-i:
        print(" ",end='')
        space+=1
    j=1
    while j<=i:
        print("* ",end='')
        j+=1
    print()
    i+=1
i=n-1
while i>=1:
    space=1
    while space <=n-i:
        print(" ",end='')
        space=space+1
    j=1
    while j<=i:
        print("* ",end='')
        j+=1
    print()
    i-=1

