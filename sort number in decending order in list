L = []
n = int(input("Enter number of elements: "))

for i in range(n):
    num = int(input("Enter number: "))
    L.append(num)

print("Original list:", L)

# Bubble Sort - Descending Order
for i in range(n - 1):
    for j in range(n - 1 - i):
        if L[j] < L[j + 1]:
            temp = L[j]
            L[j] = L[j + 1]
            L[j + 1] = temp

print("List in descending order:", L)