n = int(input("Enter the number of elements: "))

lst = []

for i in range(n):
    num = int(input("Enter number: "))
    lst.append(num)

max1 = lst[0]
max2 = None

for num in lst:
    if num > max1:
        max2 = max1
        max1 = num
    elif num != max1 and (max2 is None or num > max2):
        max2 = num

if max2 is None:
    print("Second maximum does not exist")
else:
    print("Second maximum value =", max2)